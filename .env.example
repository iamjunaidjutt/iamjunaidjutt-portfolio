EMAIL=
EMAIL_PASSWORD=

# Provider (Gemini through its OpenAI-compatible endpoint)
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY=""
# No default model on purpose. Pick a current one from https://ai.google.dev/gemini-api/docs/models
LLM_MODEL="gemini-3.1-flash-lite"
# Optional: minimal | low | medium | high
LLM_REASONING_EFFORT=
# Optional. Leave empty for Gemini 3 (Google recommends the default of 1.0)
LLM_TEMPERATURE=

# Another OpenAI-compatible provider works too, for example:
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4o-mini"

GITHUB_TOKEN=
# Web search: set ONE of these. Tavily can be limited to Junaid's own pages.
TAVILY_API_KEY=
# Or Google Search through Gemini's native API (general questions only; may be billed per search)
GEMINI_GROUNDED_SEARCH=
GEMINI_SEARCH_MODEL=

CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_DAY=200
CHAT_EMAIL_LIMIT_PER_DAY=3
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
