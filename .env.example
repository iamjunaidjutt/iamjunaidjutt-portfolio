EMAIL=
EMAIL_PASSWORD=

# Provider Configuration
# Set LLM_BASE_URL to point to Gemini, Groq, OpenAI, or a LiteLLM proxy instance:
LLM_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY="AIzaSy..." # Your Gemini API key
LLM_MODEL="gemini-1.5-flash"

# If switching back to Groq later:
# LLM_BASE_URL="https://api.groq.com/openai/v1"
# LLM_API_KEY="gsk_..."
# LLM_MODEL="llama-3.3-70b-versatile"

# If switching to OpenAI:
# LLM_BASE_URL="https://api.openai.com/v1"
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4o-mini"

GITHUB_TOKEN=
TAVILY_API_KEY=
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_RATE_LIMIT_PER_DAY=200
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: use Groq's built-in browser_search instead of Tavily (gpt-oss models only)
GROQ_NATIVE_WEB_SEARCH=
